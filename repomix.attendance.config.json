{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-attendance.xml",
    "style": "xml",
    "compress": false,
    "truncateBase64": true,
    "topFilesLength": 10,
    "git": {
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "backend/routes/web/attendance.php",
    "backend/routes/api/attendance.php",
    "backend/app/Http/Controllers/Api/AttendanceController.php",
    "backend/app/Http/Controllers/Api/HcmSmartAttendanceController.php",
    "backend/app/Http/Controllers/Api/HcmShiftController.php",
    "backend/app/Models/AttendanceRecord.php",
    "backend/app/Models/Company.php",
    "backend/app/Models/CompanyUser.php",
    "backend/app/Models/EmployeeProfile.php",
    "backend/app/Models/HcmScheduleRoster.php",
    "backend/app/Models/HcmScheduleTiming.php",
    "backend/app/Models/HcmShift.php",
    "backend/app/Models/HcmSmartPlannerSetting.php",
    "backend/app/Models/User.php",
    "backend/app/Services/Hcm/SmartAttendanceShiftingService.php",
    "backend/app/Services/LocationService.php",
    "docs/database/SCHEMA-SNAPSHOT.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/public/build/**",
      "frontend/resources/img/**",
      "backend/public/**",
      "backend/storage/**",
      "**/*.min.js",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "**/*.bmp",
      "**/*.tiff",
      "**/*.avif",
      "**/*.svg",
      "**/*.pdf",
      "**/*.zip",
      "**/*.tar",
      "**/*.gz",
      "repomix-output*.xml",
      "repomix-hcm*.xml"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
