{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-payroll.xml",
    "style": "xml",
    "compress": false,
    "truncateBase64": true,
    "topFilesLength": 10,
    "git": {
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "backend/routes/web/payroll.php",
    "backend/routes/api/payroll.php",
    "backend/app/Http/Controllers/Api/HcmPayrollPeriodController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollRunController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollWorkArrangementController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollItemController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollItemAssignmentController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollPkwtCompensationController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollThrController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollThrBatchController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollThrSettingsController.php",
    "backend/app/Http/Controllers/Api/HcmPayrollSettingsController.php",
    "backend/app/Models/CompanySetting.php",
    "backend/app/Models/HcmEmployeePayrollItemAssignment.php",
    "backend/app/Models/HcmEmployeeWorkArrangement.php",
    "backend/app/Models/HcmPayrollItem.php",
    "backend/app/Models/HcmPayrollLine.php",
    "backend/app/Models/HcmPayrollPeriod.php",
    "backend/app/Models/HcmPayrollRun.php",
    "backend/app/Models/HcmPayrollWorkProfile.php",
    "backend/app/Models/HcmSalaryComponent.php",
    "backend/app/Models/HcmTermination.php",
    "backend/app/Models/HcmThrBatch.php",
    "backend/app/Models/HcmThrBatchLine.php",
    "backend/app/Models/HcmThrYearlySetting.php",
    "backend/app/Models/User.php",
    "backend/app/Services/Hcm/MonthlyPayslipService.php",
    "backend/app/Services/Hcm/PayrollLateArrivalMigrationService.php",
    "backend/app/Services/Hcm/PayrollMonthlySettingsService.php",
    "backend/app/Services/Hcm/PkwtCompensationService.php",
    "backend/app/Services/Hcm/ThrBatchService.php",
    "backend/app/Services/Hcm/ThrProRataCalculator.php",
    "backend/app/Services/Reconciliation/Exceptions/ExportReconciliationException.php",
    "backend/app/Services/Reconciliation/ReconciliationGateService.php",
    "docs/database/SCHEMA-SNAPSHOT.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/public/build/**",
      "frontend/resources/img/**",
      "backend/public/**",
      "backend/storage/**",
      "**/*.min.js",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "**/*.bmp",
      "**/*.tiff",
      "**/*.avif",
      "**/*.svg",
      "**/*.pdf",
      "**/*.zip",
      "**/*.tar",
      "**/*.gz",
      "repomix-output*.xml",
      "repomix-hcm*.xml"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
