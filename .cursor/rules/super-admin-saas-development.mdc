### 3. JavaScript (Unified modal, camelCase mapping)
```javascript
const PackagesManager = {
    currentEditId: null,
    packageModalInstance: null,
    
    init: function() {
        this.bindEvents();
        this.packageModalInstance = window.bootstrap.Modal.getOrCreateInstance(
            document.getElementById("packageModal")
        );
    },
    
    handleSavePackage: function(form) {
        // Field mapping: API → Form → Payload
        const name = document.getElementById("input_package_name").value;
        const monthlyPrice = document.getElementById("input_package_price").value;
        
        const data = {
            name: name,
            monthly_price: parseFloat(monthlyPrice),  // snake_case for backend
            status: this.currentEditId ? "active" : "inactive",
        };
        
        const url = this.currentEditId 
            ? `/v1/saas/packages/${this.currentEditId}`
            : `/v1/saas/packages`;
        const method = this.currentEditId ? "PUT" : "POST";
        
        apiRequest(method, url, data)
            .then(response => {
                if (response.success) {
                    // Use window.ArcavUi if available
                    if (window.ArcavUi?.showSuccess) {
                        window.ArcavUi.showSuccess("Package saved");
                    }
                    this.packageModalInstance.hide();
                    this.loadPackages();
                }
            });
    }
};
```

