{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "repomix-output-employee.xml",
    "style": "xml",
    "compress": false,
    "truncateBase64": true,
    "topFilesLength": 10,
    "git": {
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "include": [
    "backend/routes/web/employee.php",
    "backend/routes/api/employee.php",
    "backend/app/Http/Controllers/Api/HcmEmployeeController.php",
    "backend/app/Http/Controllers/Api/HcmTeamController.php",
    "backend/app/Http/Controllers/Api/WilayahLookupController.php",
    "backend/app/Models/Company.php",
    "backend/app/Models/CompanyUser.php",
    "backend/app/Models/Department.php",
    "backend/app/Models/Designation.php",
    "backend/app/Models/EmployeeAssignment.php",
    "backend/app/Models/EmployeeProfile.php",
    "backend/app/Models/HcmManualActivity.php",
    "backend/app/Models/HcmRole.php",
    "backend/app/Models/HcmScheduleTiming.php",
    "backend/app/Models/HcmUserRole.php",
    "backend/app/Models/Policy.php",
    "backend/app/Models/Team.php",
    "backend/app/Models/User.php",
    "backend/app/Models/WilayahDistrict.php",
    "backend/app/Models/WilayahProvince.php",
    "backend/app/Models/WilayahRegency.php",
    "backend/app/Models/WilayahVillage.php",
    "backend/app/Services/EmployeeCountValidator.php",
    "backend/app/Services/Hcm/EmployeeSnapshotService.php",
    "backend/app/Services/Hcm/PkwtCompensationService.php",
    "backend/app/Services/Media/AvatarStorageService.php",
    "backend/app/Services/Media/Exceptions/InvalidMediaException.php",
    "backend/app/Services/Media/MediaFileDeleter.php",
    "backend/app/Services/Media/PolicyAttachmentStorageService.php",
    "docs/database/SCHEMA-SNAPSHOT.md"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/public/build/**",
      "frontend/resources/img/**",
      "backend/public/**",
      "backend/storage/**",
      "**/*.min.js",
      "**/*.map",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "**/*.bmp",
      "**/*.tiff",
      "**/*.avif",
      "**/*.svg",
      "**/*.pdf",
      "**/*.zip",
      "**/*.tar",
      "**/*.gz",
      "repomix-output*.xml",
      "repomix-hcm*.xml"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
