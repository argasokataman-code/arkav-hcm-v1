backend/public/build/

# Storage and temporary files
backend/storage/
release/
.git/

# Binary image files
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.svg
**/*.ico

# Binary document files
**/*.pdf
**/*.xlsx

# Compressed archives
**/*.tgz
**/*.gz
**/*.zip
**/*.tar

# Minified and source map files
**/*.min.js
**/*.map

