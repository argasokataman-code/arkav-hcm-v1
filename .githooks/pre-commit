#!/usr/bin/env bash
# Pre-commit hook: check PHP syntax in staged test files
set -euo pipefail

red='\033[0;31m'; green='\033[0;32m'; nc='\033[0m'

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^backend/tests/.*\.php$' || true)
if [ -z "$staged" ]; then
    exit 0
fi

errors=0
while IFS= read -r file; do
    if ! php -l "$file" >/dev/null 2>&1; then
        echo -e "${red}PHP syntax error in${nc} $file"
        php -l "$file" 2>&1 | tail -1
        errors=$((errors + 1))
    fi
done <<< "$staged"

if [ $errors -gt 0 ]; then
    echo -e "${red}✗ $errors PHP syntax error(s) found. Fix before commit.${nc}"
    exit 1
fi

echo -e "${green}✓ PHP syntax check passed${nc}"
