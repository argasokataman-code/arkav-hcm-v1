#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
RUN_GUARD="false"

# pre-push stdin format: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    RUN_GUARD="true"
    break
  fi
done

if [[ "$RUN_GUARD" != "true" ]]; then
  exit 0
fi

echo "[pre-push] main branch detected: running mandatory local-first guards"

# Check-tests-on-change runs here (not pre-commit) so developers can commit freely
# and tests are required only before push
echo "[pre-push] 0/3 API/feature test coverage check"
bash "$ROOT_DIR/scripts/check-tests-on-change.sh"

echo "[pre-push] 1/3 local test gate"
CACHED_COMMIT="$(cat "$ROOT_DIR/.test-gate-passed" 2>/dev/null || true)"
CURRENT_HEAD="$(git -C "$ROOT_DIR" rev-parse HEAD)"
if [[ "$CACHED_COMMIT" == "$CURRENT_HEAD" ]]; then
  echo "[pre-push] test gate cache HIT for $CURRENT_HEAD — skipping (already passed)"
else
  bash "$ROOT_DIR/scripts/local-test-gate.sh"
  echo "$CURRENT_HEAD" > "$ROOT_DIR/.test-gate-passed"
fi

echo "[pre-push] 2/3 artifact sync guard"
bash "$ROOT_DIR/scripts/check-shared-hosting-artifact-sync.sh" "$(git -C "$ROOT_DIR" rev-parse HEAD)"

echo "[pre-push] 3/3 deploy runtime guard"
bash "$ROOT_DIR/scripts/check-deploy-runtime-guard.sh"

echo "[pre-push] OK: push guard passed"
